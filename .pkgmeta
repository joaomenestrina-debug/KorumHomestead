package-as: KorumHomestead

# what is only for development stays out of the zip the players download
ignore:
  - tests
  - ferramentas
  - arquivo
  - docs
  - .gitignore

# the "what's new" of each file on CurseForge comes from this file, not from the commit messages
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
